      if (!current) return;
      const filterVal = document.getElementById('guidanceFilter').value;
      const records = filterVal === 'ALL'
        ? current.guidanceRecords
        : current.guidanceRecords.filter(g => g.firmness === filterVal);

      const gContainer = document.getElementById('guidanceContainer');
      if (records.length === 0) {
        gContainer.innerHTML = `<p class="text-xs text-[#8b949e]">No guidance statements matched the selected filter.</p>`;
        return;
      }

      gContainer.innerHTML = `
        <table class="w-full border-collapse text-left text-xs md:text-sm">
          <thead>
            <tr class="bg-[#21262d] text-[#f0f6fc] border-b border-[#30363d]">
              <th class="p-3">Firmness</th>
              <th class="p-3">Category</th>
              <th class="p-3">Target / Quantum</th>
              <th class="p-3">Timeline</th>
              <th class="p-3">Verbatim Statement</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#30363d]">
            ${records.map(g => {
              const bCls = g.firmness === 'Firm Commitment' ? 'badge-firm' : (g.firmness === 'Hedged / Soft' ? 'badge-mod' : 'badge-neutral');
              return `
                <tr>
                  <td class="p-3"><span class="badge ${bCls}">${escapeHtml(g.firmness)}</span></td>
                  <td class="p-3 font-semibold text-[#f0f6fc]">${escapeHtml(g.metric_category)}</td>
                  <td class="p-3 mono text-[#58a6ff] font-semibold">${escapeHtml(g.quantums.join(', '))}</td>
                  <td class="p-3 mono">${escapeHtml(g.timelines.join(', '))}</td>
                  <td class="p-3 text-xs leading-relaxed">${escapeHtml(g.sentence)}</td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      `;
    }

    // Handle uploaded files
    async function handleFiles(fileList) {
      const files = Array.from(fileList);
      if (files.length === 0) return;

      const statusEl = document.getElementById('parseStatus');
      statusEl.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const f = files[i];
        statusEl.textContent = `[*] Reading & auditing (${i + 1}/${files.length}): ${f.name}...`;
        try {
          const text = await extractTextFromFile(f);
          if (text && text.trim().length > 50) {
            const result = analyzeTranscript(text, f.name);
            analyzedCalls.push(result);
            activeCallIndex = analyzedCalls.length - 1;
          } else {
            statusEl.textContent = `[!] ${f.name} appears to be a scanned image PDF with no selectable text layer.`;
          }
        } catch (err) {
          statusEl.textContent = `[!] Error reading ${f.name}: ${err.message}`;
        }
      }

      statusEl.textContent = `[+] Audited ${analyzedCalls.length} concall transcript(s) offline.`;
      renderAll();
    }

    // Export standalone HTML report
    function exportStandaloneReport() {
      if (analyzedCalls.length === 0) return;
      const current = analyzedCalls[activeCallIndex];
      const reportHtml = `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Institutional Autopsy — ${escapeHtml(current.metadata.company)} (${escapeHtml(current.metadata.period)})</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0d1117; color: #c9d1d9; padding: 30px; line-height: 1.5; }
  .container { max-width: 1150px; margin: 0 auto; }
  h1, h2, h3 { color: #f0f6fc; margin-top: 0; }
  .section { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  th, td { border: 1px solid #30363d; padding: 10px; text-align: left; font-size: 13px; }
  th { background: #21262d; color: #f0f6fc; }
</style>
</head>
<body>
  <div class="container">
    <h1>CONCALL CONFESSIONS // ${escapeHtml(current.metadata.company)} (${escapeHtml(current.metadata.period)})</h1>
    <p>Candor Score: <strong>${current.qaAudit.candorScore}/10</strong> | Credibility Read: <strong>${escapeHtml(current.credibilityRating)}</strong> | Deflection Rate: <strong>${current.qaAudit.deflectionRatePct}%</strong> | Hedge Density: <strong>${current.qaAudit.hedgeDensityPct}%</strong></p>
    ${document.getElementById('multiCallSection').classList.contains('hidden') ? '' : `<div class="section"><h2>Multi-Concall Comparison</h2>${document.getElementById('multiCallSection').innerHTML}</div>`}
    <div class="section"><h2>Forensic Red Flags</h2>${document.getElementById('redFlagsContainer').innerHTML}</div>
    <div class="section"><h2>Forward Guidance (${current.guidanceRecords.length})</h2>${document.getElementById('guidanceContainer').innerHTML}</div>
    <div class="section"><h2>Audited Q&A Deflections</h2>${document.getElementById('deflectionsContainer').innerHTML}</div>
    <div class="section"><h2>Capex, Debt & Margin Drivers</h2>${document.getElementById('driversContainer').innerHTML}</div>
  </div>
</body>
</html>`;
      const blob = new Blob([reportHtml], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `autopsy_${current.metadata.company.replace(/\s+/g, '_')}_${current.metadata.period.replace(/\s+/g, '_')}.html`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Event Listeners
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');

    document.getElementById('btnSelectFiles').addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drop-active');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drop-active'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drop-active');
      if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFiles(e.dataTransfer.files);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files.length > 0) {
        handleFiles(e.target.files);
        fileInput.value = '';
      }
    });

    document.getElementById('btnPasteModal').addEventListener('click', () => {
      document.getElementById('pastePanel').classList.toggle('hidden');
    });
    document.getElementById('btnClosePaste').addEventListener('click', () => {
      document.getElementById('pastePanel').classList.add('hidden');
    });
    document.getElementById('btnRunPasted').addEventListener('click', () => {
      const title = document.getElementById('pasteTitleInput').value.trim() || `Pasted_Concall_${analyzedCalls.length + 1}`;
      const raw = document.getElementById('pasteTextArea').value;
      if (raw && raw.trim().length > 50) {
        const res = analyzeTranscript(raw, `${title}.txt`, title);
        analyzedCalls.push(res);
        activeCallIndex = analyzedCalls.length - 1;
        document.getElementById('pasteTextArea').value = '';
        document.getElementById('pasteTitleInput').value = '';
        document.getElementById('pastePanel').classList.add('hidden');
        renderAll();
      }
    });

    document.getElementById('guidanceFilter').addEventListener('change', renderGuidanceTable);
    document.getElementById('btnExportHtml').addEventListener('click', exportStandaloneReport);
    document.getElementById('btnClearAll').addEventListener('click', () => {
      analyzedCalls = [];
      activeCallIndex = 0;
      document.getElementById('parseStatus').classList.add('hidden');
      renderAll();
    });
  </script>
</body>
</html>
