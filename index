              <strong class="not-italic text-[#58a6ff]">Analyst (${escapeHtml(ev.analyst)}):</strong> ${escapeHtml(ev.preceding_question)}
            </div>
            <div class="border-l-2 border-[#f85149] bg-[#161b22] p-2.5 text-xs italic">
              <strong class="not-italic text-[#f85149]">Management Response:</strong> ${escapeHtml(ev.deflected_statement)}
