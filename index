      document.getElementById('statDeflectionSub').textContent = `${current.qaAudit.explicitDeflectionCount} offline dodges + ${current.qaAudit.numericEvasionCount} numeric evasions`;

      document.getElementById('statHedgeDensity').textContent = `${current.qaAudit.hedgeDensityPct}%`;
      document.getElementById('statHedgeSub').textContent = `${current.qaAudit.hedgedResponses.length} heavily hedged Q&A replies`;

      const firmCount = current.guidanceRecords.filter(g => g.firmness === 'Firm Commitment').length;
      const softCount = current.guidanceRecords.filter(g => g.firmness === 'Hedged / Soft').length;
      document.getElementById('statTargetsCount').textContent = `${current.guidanceRecords.length}`;
      document.getElementById('statTargetsSub').textContent = `${firmCount} Firm • ${softCount} Soft/Hedged`;

      // Red Flags
      const rfContainer = document.getElementById('redFlagsContainer');
      if (current.redFlags.length === 0) {
        rfContainer.innerHTML = `<p class="text-sm text-[#3fb950]">No severe deterministic red flags or evasions detected in this transcript.</p>`;
      } else {
        rfContainer.innerHTML = `
          <table class="w-full border-collapse text-left text-xs md:text-sm">
            <thead>
              <tr class="bg-[#21262d] text-[#f0f6fc] border-b border-[#30363d]">
                <th class="p-3">Severity</th>
                <th class="p-3">Category</th>
                <th class="p-3">Forensic Finding</th>
                <th class="p-3">Transcript Evidence</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#30363d]">
              ${current.redFlags.map(fl => `
                <tr>
                  <td class="p-3"><span class="badge ${fl.severity === 'Severe' ? 'badge-severe' : 'badge-mod'}">${escapeHtml(fl.severity)}</span></td>
                  <td class="p-3 font-semibold text-[#f0f6fc]">${escapeHtml(fl.category)}</td>
                  <td class="p-3">${escapeHtml(fl.finding)}</td>
                  <td class="p-3 mono text-xs text-[#8b949e]">${escapeHtml(fl.sample)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      }

      // Guidance Table
      renderGuidanceTable();

      // Deflections
      const defContainer = document.getElementById('deflectionsContainer');
      if (current.qaAudit.deflectionEvents.length === 0) {
        defContainer.innerHTML = `<p class="text-sm text-[#3fb950]">Zero explicit question deflections or quantitative evasions identified in Q&A session.</p>`;
      } else {
        defContainer.innerHTML = current.qaAudit.deflectionEvents.map(ev => `
          <div class="bg-[#0d1117] border border-[#30363d] rounded-lg p-4 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-bold text-[#f85149] mono">[${escapeHtml(ev.type)}] Trigger: "${escapeHtml(ev.trigger_phrase)}"</span>
              <span class="text-xs text-[#8b949e]">Speaker: <strong class="text-[#c9d1d9]">${escapeHtml(ev.speaker)}</strong></span>
