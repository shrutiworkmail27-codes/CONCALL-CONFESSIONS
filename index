  <script>
    // Configure PDF.js worker if available
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    // Embedded Lexicons (Exact match with upgraded Python repo)
    const LEXICONS = {
      deflections: [
        "take this offline", "take that offline", "discuss offline", "connect offline",
        "take it offline", "offline discussion", "touch base offline", "speak offline",
        "don't have the exact figure", "do not have the exact number", "don't have the exact number",
        "do not have that handy", "don't have that handy", "don't have the exact",
        "team will share the details", "investor relations will get back", "will revert back",
        "will get back to you", "cannot share at this stage", "not in a position to disclose",
        "we do not provide guidance on", "we don't give breakup", "do not give segment breakup",
        "too early to give guidance", "premature to comment", "difficult to quantify",
        "hard to put a number", "as i mentioned earlier", "as already explained",
        "as stated previously", "like we said in the opening remarks", "already answered that"
      ],
      hedges: [
        "subject to", "contingent upon", "depends on", "depending on orders",
        "based on market conditions", "order inflows permitting", "if all goes well",
        "assuming no further", "provided that", "barring unforeseen", "roughly",
        "approximate", "around", "give or take", "ballpark", "more or less",
        "tentative", "tentatively", "in the vicinity of", "broadly in line",
        "some bit of", "hopefully", "we believe", "we assume", "we expect maybe",
        "likely", "probably", "striving for", "aspirational", "not set in stone",
        "yet to finalize", "endeavor to", "wait and watch", "fingers crossed"
      ],
      marginDrivers: [
        "operating leverage", "raw material", "input cost", "freight cost", "product mix",
        "utilization", "pricing power", "price hike", "inventory lag", "power and fuel",
        "realization", "backward integration", "cost optimization", "value added products"
      ],
      redFlags: [
        "delay", "postponed", "headwind", "cancellation", "underutilized", "write-off",
        "impairment", "restructuring", "inventory buildup", "margin dilution",
        "working capital stretch", "slowdown", "destocking", "price erosion",
        "liquidated damages", "resignation", "penalty", "show cause"
      ],
      balanceSheetStress: [
        "debt", "borrowings", "leverage", "refinancing", "pledged", "receivable days",
        "working capital cycle", "capex deferral", "liquidity", "interest cost",
        "debtor days", "overdue", "covenant"
      ]
    };

    // State
    let analyzedCalls = [];
    let activeCallIndex = 0;

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeRegex(str) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // 1. Extract text from uploaded PDF or TXT
    async function extractTextFromFile(file) {
      if (file.name.toLowerCase().endsWith('.pdf')) {
        if (!window.pdfjsLib) {
          throw new Error('PDF.js library not loaded. Please check internet connection or upload a .txt transcript.');
        }
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        let pagesText = [];
        for (let i = 1; i <= pdf.numPages; i++) {
          const page = await pdf.getPage(i);
          const content = await page.getTextContent();
          let lastY = null;
          let pageStr = '';
          for (const item of content.items) {
            if (lastY !== null && Math.abs(item.transform[5] - lastY) > 4) {
              pageStr += '\n';
            } else if (pageStr.length > 0 && !pageStr.endsWith(' ') && !pageStr.endsWith('\n')) {
              pageStr += ' ';
            }
            pageStr += item.str;
            lastY = item.transform[5];
          }
          pagesText.push(pageStr);
        }
        return pagesText.join('\n\n');
      } else {
        return await file.text();
      }
    }

    // 2. Deterministic Parser + Extractor + Forensic Engine (Ported 1:1 from Python Repo)
    function analyzeTranscript(rawText, filename, customLabel) {
      let cleanText = rawText.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      cleanText = cleanText.replace(/Page\s+\d+\s+of\s+\d+/gi, '');
      cleanText = cleanText.replace(/\n{3,}/g, '\n\n').trim();

      // Metadata detection
      const headerChunk = cleanText.slice(0, 2500);
      const baseName = filename.replace(/\.[^/.]+$/, '');
      const periodRegex = /\b(Q[1-4]\s*FY\s*'?\d{2,4}|H[1-2]\s*FY\s*'?\d{2,4}|FY\s*'?\d{2,4}|Q[1-4]\s+20\d{2})\b/i;
      const periodMatch = headerChunk.match(periodRegex) || baseName.match(periodRegex);
      const period = periodMatch ? periodMatch[1].replace(/\s+/g, ' ').toUpperCase() : 'Concall Audit';

      let company = customLabel || null;
      if (!company) {
        const compRegex = /([A-Z][A-Za-z0-9&\s.\-]{2,42}?\s+(?:Limited|Ltd\.?|Corporation|Corp\.?|Inc\.?|PLC|Enterprises|Industries))/g;
        let m;
        while ((m = compRegex.exec(headerChunk)) !== null) {
          const candidate = m[1].trim();
          const low = candidate.toLowerCase();
          if (!low.includes('chorus call') && !low.includes('link intime') && !low.includes('stock exchange') && !low.includes('national stock')) {
            company = candidate;
            break;
          }
        }
      }
      if (!company) {
        company = baseName.replace(/[_\-]+/g, ' ').trim();
      }

      const wordCount = (cleanText.match(/\b\w+\b/g) || []).length;

      // Split Opening Remarks vs Q&A Session
      const qaSplitPatterns = [
        /question[ -]and[ -]answer(?:s)?\s+session/i,
        /q\s*&\s*a\s+session/i,
        /floor\s+is\s+open\s+for\s+questions/i,
        /open\s+the\s+floor\s+for\s+q&a/i,
        /we\s+will\s+now\s+begin\s+the\s+question/i,
        /ladies\s+and\s+gentlemen,\s+we\s+will\s+now\s+begin/i,
        /first\s+question\s+is\s+from\s+the\s+line\s+of/i,
        /anyone\s+who\s+wishes\s+to\s+ask\s+a\s+question/i
      ];

      let splitPos = -1;
      for (const pat of qaSplitPatterns) {
        const match = pat.exec(cleanText);
        if (match) {
          splitPos = match.index;
          break;
        }
      }

      let qaSession = '';
      if (splitPos !== -1) {
        qaSession = cleanText.slice(splitPos).trim();
      } else {
        const twentyPct = Math.floor(cleanText.length * 0.25);
        const qIdx = cleanText.slice(twentyPct).indexOf('?');
        if (qIdx !== -1) {
          qaSession = cleanText.slice(twentyPct + Math.max(0, qIdx - 300)).trim();
        } else {
          qaSession = cleanText.slice(Math.floor(cleanText.length * 0.45)).trim();
        }
      }

      // Parse Q&A Speaker Turns
      const speakerRegex = /^(?:(?:Mr\.|Ms\.|Mrs\.|Dr\.|Shri)\s+)?[A-Z][A-Za-z.\s\-']{1,45}(?:\s*\([^\n)]{1,50}\))?\s*(?::|\s+[–—-]\s+)\s*/gm;
      const matches = [...qaSession.matchAll(speakerRegex)];
      let qaTurns = [];

      if (matches.length === 0 && qaSession.length > 0) {
        qaTurns.push({ speaker: 'Management', role: 'management', text: qaSession });
      } else {
        for (let i = 0; i < matches.length; i++) {
          const rawHeader = matches[i][0].replace(/(?::|\s+[–—-]\s+)\s*$/, '').trim();
          const startIdx = matches[i].index + matches[i][0].length;
          const endIdx = (i + 1 < matches.length) ? matches[i + 1].index : qaSession.length;
          const speech = qaSession.slice(startIdx, endIdx).trim();
          if (!speech) continue;

          const hLow = rawHeader.toLowerCase();
          let role = 'management';
          if (['moderator', 'operator', 'host', 'coordinator'].some(t => hLow.includes(t))) {
            role = 'moderator';
          } else if (['analyst', 'capital', 'securities', 'partners', 'mutual fund', 'asset', 'equities', 'broking', 'wealth', 'investments', 'institutional'].some(t => hLow.includes(t))) {
            role = 'analyst';
          } else if (['management', 'md', 'ceo', 'cfo', 'coo', 'director', 'chairman', 'president', 'vp', 'head', 'chief', 'founder', 'promoter'].some(t => hLow.includes(t))) {
            role = 'management';
          } else if (speech.includes('?') && speech.length < 950) {
            role = 'analyst';
          } else {
            const prevRole = qaTurns.length > 0 ? qaTurns[qaTurns.length - 1].role : 'moderator';
            role = (prevRole === 'analyst') ? 'management' : 'analyst';
          }
          qaTurns.push({ speaker: rawHeader, role, text: speech });
        }
      }

      // Sentence splitting (protecting Rs., Mr., Ltd., etc.)
      const flatText = cleanText.replace(/\s+/g, ' ');
      const protectedText = flatText.replace(/\b(Rs|Mr|Ms|Mrs|Dr|Prof|Sr|Jr|St|Ltd|Inc|Corp|Co|vs|etc|approx|fy|qtr)\./gi, '$1<PRD>');
      const sentences = protectedText
        .split(/(?<=[.?!])\s+(?=[A-Z0-9"'])/)
        .map(s => s.replace(/<PRD>/g, '.').trim())
        .filter(s => s.length > 18);

      const timelineRegex = /\b(?:Q[1-4]\s*(?:FY)?\s*'?\d{2,4}|FY\s*'?\d{2,4}|H[1-2]\s*(?:FY)?\s*'?\d{2,4}|(?:by|in|for)\s+20\d{2}(?:-\d{2})?|next\s+(?:quarter|year|two\s+quarters|fiscal|12\s+months)|second\s+half|first\s+half)\b/gi;
      const quantumRegex = /(?:(?:Rs\.?|INR|₹|\$|€|USD)\s*[\d,]+(?:\.\d+)?\s*(?:Cr(?:ore(?:s)?)?|Lakh(?:s)?|Mn|Bn|Billion|Million|k)?|[\d,]+(?:\.\d+)?\s*(?:-\s*[\d,]+(?:\.\d+)?\s*)?(?:Cr(?:ore(?:s)?)?|Lakh(?:s)?|Mn|Bn|Billion|Million|bps|basis\s+points|%|percent|x\b|times\b))/gi;
      const intentRegex = /\b(?:guidance|guiding|guide|target|targeting|expect|expecting|aim|aiming|project|projecting|estimate|estimating|aspirational|run-rate|run\s+rate|outlook|visibility|deliver|achieve|grow\s+by|growth\s+of|revenue\s+of|margin\s+of|ebitda\s+of|pat\s+of|cagr)\b/i;

      function classifyCategory(s) {
        const low = s.toLowerCase();
        if (['revenue', 'top line', 'topline', 'sales', 'turnover', 'order book', 'inflow', 'volume', 'cagr'].some(k => low.includes(k))) return 'Revenue / Top-line';
        if (['margin', 'ebitda', 'pat', 'gross', 'operating', 'profitability', 'bps', 'basis points', 'roce', 'roe'].some(k => low.includes(k))) return 'Margins / Profitability';
        if (['capex', 'capital expenditure', 'capacity', 'commissioning', 'expansion', 'plant', 'utilization'].some(k => low.includes(k))) return 'Capex / Capacity';
        if (['debt', 'borrowing', 'leverage', 'working capital', 'receivable', 'inventory', 'repayment'].some(k => low.includes(k))) return 'Debt / Working Capital';
        return 'General Operational';
      }

      function assessFirmness(s) {
        const low = s.toLowerCase();
        if (['maybe', 'subject to', 'tentative', 'depends', 'hope', 'hopefully', 'aspirational', 'roughly', 'ballpark', 'around', 'broadly', 'endeavor', 'if all goes well', 'likely', 'probably', 'contingent'].some(h => low.includes(h))) {
          return 'Hedged / Soft';
        }
        if (['confident', 'firmly', 'committed', 'on track', 'locked in', 'definitely', 'certainly', 'assured', 'visibly', 'at least', 'minimum'].some(f => low.includes(f))) {
          return 'Firm Commitment';
        }
        return 'Standard Guidance';
      }

      const guidanceRecords = [];
      const capexList = [];
      const debtList = [];
      const marginDrivers = [];

      const marginKeywordRegex = /\b(margin|margins|ebitda|gross margin|operating margin|profitability|spreads)\b/i;
      const driverKeywordRegex = new RegExp('\\b(' + LEXICONS.marginDrivers.map(escapeRegex).join('|') + ')\\b', 'gi');

      for (const sentence of sentences) {
        const quantums = [...new Set((sentence.match(quantumRegex) || []).map(q => q.trim()))];
        const timelines = [...new Set((sentence.match(timelineRegex) || []).map(t => t.trim()))];
        const sLow = sentence.toLowerCase();

        if (intentRegex.test(sentence) && quantums.length > 0) {
          guidanceRecords.push({
            metric_category: classifyCategory(sentence),
            sentence,
            quantums,
            timelines: timelines.length > 0 ? timelines : ['Ongoing / Full Year'],
            firmness: assessFirmness(sentence)
          });
        }

        if (['capex', 'capital expenditure', 'brownfield', 'greenfield', 'commissioning', 'capacity addition'].some(c => sLow.includes(c)) && quantums.length > 0) {
          capexList.push({ sentence, figures: quantums });
        }

        if (['debt', 'borrowing', 'deleverage', 'repayment', 'working capital', 'receivable days', 'interest cost'].some(d => sLow.includes(d)) && quantums.length > 0) {
          debtList.push({ sentence, figures: quantums });
        }

        if (marginKeywordRegex.test(sentence)) {
          const dMatches = sentence.match(driverKeywordRegex);
          if (dMatches && dMatches.length > 0) {
            const uniqueDrivers = [...new Set(dMatches.map(d => d.toLowerCase()))];
            marginDrivers.push({
              drivers: uniqueDrivers,
              quantums,
              statement: sentence
            });
          }
        }
      }

      // Audit Q&A Turns
      const deflectionEvents = [];
      const numericEvasions = [];
      const hedgedResponses = [];
      let totalMgmtTurns = 0;
      let totalAnalystQuestions = 0;

      const numericQuestionRegex = /\b(how\s+much|what\s+is\s+the|what\s+was\s+the|quantify|breakup|break-up|split|percentage|margin|capex|guidance|target|number|figure|run\s+rate|utilization)\b/i;
      const numberInAnswerRegex = /(?:\b\d+(?:\.\d+)?\s*(?:%|percent|bps|cr|crore|lakh|mn|million|bn|billion|x|times)\b|(?:rs\.?|inr|₹|\$)\s*\d+)/i;

      for (let i = 0; i < qaTurns.length; i++) {
        const turn = qaTurns[i];
        if (turn.role === 'analyst') {
          totalAnalystQuestions++;
        } else if (turn.role === 'management') {
          totalMgmtTurns++;
          const speech = turn.text;
          const words = speech.match(/\b\w+\b/g) || [];

          let priorQuestion = '';
          let priorSpeaker = 'Analyst';
          for (let j = i - 1; j >= 0; j--) {
            if (qaTurns[j].role === 'analyst') {
              priorQuestion = qaTurns[j].text;
              priorSpeaker = qaTurns[j].speaker;
              break;
            }
          }

          let explicitDodge = false;
          for (const dodge of LEXICONS.deflections) {
            const dReg = new RegExp('\\b' + escapeRegex(dodge) + '\\b', 'i');
            if (dReg.test(speech)) {
              deflectionEvents.push({
                type: 'Explicit Deflection / Offline Dodge',
                speaker: turn.speaker,
                analyst: priorSpeaker,
                trigger_phrase: dodge,
                deflected_statement: speech.length > 260 ? speech.slice(0, 260) + '...' : speech,
                preceding_question: priorQuestion ? (priorQuestion.length > 240 ? priorQuestion.slice(0, 240) + '...' : priorQuestion) : 'Opening Q&A exchange'
              });
              explicitDodge = true;
              break;
            }
          }

          if (!explicitDodge && priorQuestion && numericQuestionRegex.test(priorQuestion)) {
            if (!numberInAnswerRegex.test(speech) && words.length >= 25) {
              numericEvasions.push({
                type: 'Quantitative Evasion (Zero Numbers Given)',
                speaker: turn.speaker,
                analyst: priorSpeaker,
                trigger_phrase: 'Zero figures provided on quantitative query',
                deflected_statement: speech.length > 260 ? speech.slice(0, 260) + '...' : speech,
                preceding_question: priorQuestion.length > 240 ? priorQuestion.slice(0, 240) + '...' : priorQuestion
              });
            }
          }

          const hedgesFound = LEXICONS.hedges.filter(h => new RegExp('\\b' + escapeRegex(h) + '\\b', 'i').test(speech));
          if (hedgesFound.length >= 2) {
            hedgedResponses.push({
              speaker: turn.speaker,
              hedge_count: hedgesFound.length,
              hedges: hedgesFound,
              statement: speech.length > 260 ? speech.slice(0, 260) + '...' : speech
            });
          }
        }
      }

      const allEvasions = [...deflectionEvents, ...numericEvasions.slice(0, 5)];
      const hedgeDensity = (hedgedResponses.length / Math.max(1, totalMgmtTurns)) * 100;
      const deflectionRate = (allEvasions.length / Math.max(1, totalMgmtTurns)) * 100;

      const candorPenalty = (deflectionEvents.length * 1.35) + (numericEvasions.slice(0, 5).length * 0.65) + (hedgeDensity * 0.07);
      const candorScore = Number(Math.max(1.0, Math.min(10.0, 10.0 - candorPenalty)).toFixed(1));

      // Evaluate Red Flags
      const redFlags = [];
      if (allEvasions.length >= 2) {
        redFlags.push({
          severity: allEvasions.length >= 4 ? 'Severe' : 'Moderate',
          category: 'Management Candor / Question Dodging',
          finding: `Management deflected ${deflectionEvents.length} inquiry(s) offline and gave ${numericEvasions.length} non-numeric evasion(s) during Q&A.`,
          sample: allEvasions[0].trigger_phrase
        });
      }

      const softTargets = guidanceRecords.filter(g => g.firmness === 'Hedged / Soft');
      if (softTargets.length > 0) {
        const softRatio = softTargets.length / Math.max(1, guidanceRecords.length);
        redFlags.push({
          severity: (softTargets.length >= 4 || softRatio >= 0.6) ? 'Severe' : 'Moderate',
          category: 'Guidance Reliability / Soft Targets',
          finding: `${softTargets.length} of ${guidanceRecords.length} forward target(s) (${Math.round(softRatio * 100)}%) were softened with conditionality or hedge words.`,
          sample: softTargets[0].sentence.slice(0, 180)
        });
      }

      let rfHits = [];
      for (const rfWord of LEXICONS.redFlags) {
        const matches = [...cleanText.matchAll(new RegExp(`([^.?!]*\\b${escapeRegex(rfWord)}\\b[^.?!]*)`, 'gi'))];
        if (matches.length > 0) {
          rfHits.push({ word: rfWord, count: matches.length, sample: matches[0][1].trim() });
        }
      }
      rfHits.sort((a, b) => b.count - a.count);
      const totalRfCount = rfHits.reduce((acc, item) => acc + item.count, 0);
      if (totalRfCount >= 3) {
        const topTerms = rfHits.slice(0, 4).map(x => `'${x.word}' (${x.count}x)`).join(', ');
        redFlags.push({
          severity: totalRfCount >= 8 ? 'Severe' : 'Moderate',
          category: 'Operational Headwinds & Delays',
          finding: `Detected ${totalRfCount} mentions of operational stress markers across transcript: ${topTerms}.`,
          sample: rfHits[0].sample.slice(0, 180)
        });
      }

      let stressHits = [];
      for (const stWord of LEXICONS.balanceSheetStress) {
        const matches = [...cleanText.matchAll(new RegExp(`([^.?!]*\\b${escapeRegex(stWord)}\\b[^.?!]*)`, 'gi'))];
        if (matches.length >= 3) {
          stressHits.push({ word: stWord, count: matches.length, sample: matches[0][1].trim() });
        }
      }
      stressHits.sort((a, b) => b.count - a.count);
      if (stressHits.length > 0) {
        redFlags.push({
          severity: stressHits[0].count >= 7 ? 'Severe' : 'Moderate',
          category: 'Balance Sheet / Working Capital Focus',
          finding: `Elevated discussion around '${stressHits[0].word}' (${stressHits[0].count} mentions) and balance sheet liquidity metrics.`,
          sample: stressHits[0].sample.slice(0, 180)
        });
      }

      const severeCount = redFlags.filter(f => f.severity === 'Severe').length;
      let credibilityRating = 'Promotional / Unreliable';
      if (candorScore >= 8.5 && severeCount === 0) credibilityRating = 'Exceptional';
      else if (candorScore >= 7.0 && severeCount === 0) credibilityRating = 'Strong';
      else if (candorScore >= 5.5 && severeCount <= 1) credibilityRating = 'Moderate';
      else if (candorScore >= 3.8 && severeCount <= 2) credibilityRating = 'Weak';

      return {
        metadata: { company, period, filename, wordCount },
        qaAudit: {
          candorScore,
          totalMgmtTurns,
          totalAnalystQuestions,
          deflectionEvents: allEvasions,
          explicitDeflectionCount: deflectionEvents.length,
          numericEvasionCount: numericEvasions.length,
          hedgedResponses,
          deflectionRatePct: Number(deflectionRate.toFixed(1)),
          hedgeDensityPct: Number(hedgeDensity.toFixed(1))
        },
        guidanceRecords,
        capexDebt: { capex: capexList, debt: debtList },
        marginDrivers,
        redFlags,
        credibilityRating
      };
    }

    function getCredibilityBadgeClass(rating) {
      if (rating === 'Exceptional' || rating === 'Strong') return 'badge-firm';
      if (rating === 'Moderate') return 'badge-mod';
      return 'badge-severe';
    }

    // 3. Render UI
    function renderAll() {
      const emptyBox = document.getElementById('emptyStateBox');
      const workspace = document.getElementById('analysisWorkspace');
      const btnExport = document.getElementById('btnExportHtml');
      const btnClear = document.getElementById('btnClearAll');

      if (analyzedCalls.length === 0) {
        emptyBox.classList.remove('hidden');
        workspace.classList.add('hidden');
        btnExport.classList.add('hidden');
        btnClear.classList.add('hidden');
        return;
      }

      emptyBox.classList.add('hidden');
      workspace.classList.remove('hidden');
      btnExport.classList.remove('hidden');
      btnClear.classList.remove('hidden');

      if (activeCallIndex >= analyzedCalls.length) activeCallIndex = analyzedCalls.length - 1;

      // Multi-call section
      const multiSec = document.getElementById('multiCallSection');
      if (analyzedCalls.length >= 2) {
        multiSec.classList.remove('hidden');
        const first = analyzedCalls[0];
        const last = analyzedCalls[analyzedCalls.length - 1];
        const candorDelta = Number((last.qaAudit.candorScore - first.qaAudit.candorScore).toFixed(1));
        const hedgeDelta = Number((last.qaAudit.hedgeDensityPct - first.qaAudit.hedgeDensityPct).toFixed(1));
        const deflectDelta = Number((last.qaAudit.deflectionRatePct - first.qaAudit.deflectionRatePct).toFixed(1));

        let trajText = 'Stable Communication Posture';
        let trajClass = 'badge-neutral';
        if (candorDelta <= -1.0 || hedgeDelta >= 10.0) {
          trajText = 'Deteriorating Transparency (Rising Defensiveness)';
          trajClass = 'badge-severe';
        } else if (candorDelta >= 1.0 && hedgeDelta <= -5.0) {
          trajText = 'Improving Candor & Execution Clarity';
          trajClass = 'badge-firm';
        }

        const tBadge = document.getElementById('trajectoryBadge');
        tBadge.className = `badge ${trajClass}`;
        tBadge.textContent = trajText;

        document.getElementById('trajectorySummary').textContent =
          `Comparing ${analyzedCalls.length} loaded concalls from ${first.metadata.period} to ${last.metadata.period} • Candor Δ: ${candorDelta >= 0 ? '+' : ''}${candorDelta} pts | Hedge Density Δ: ${hedgeDelta >= 0 ? '+' : ''}${hedgeDelta}% | Deflection Rate Δ: ${deflectDelta >= 0 ? '+' : ''}${deflectDelta}%`;

        const tbody = document.getElementById('multiCallTableBody');
        tbody.innerHTML = analyzedCalls.map((c, idx) => {
          const firmCnt = c.guidanceRecords.filter(g => g.firmness === 'Firm Commitment').length;
          const softCnt = c.guidanceRecords.filter(g => g.firmness === 'Hedged / Soft').length;
          const isCurrent = idx === activeCallIndex;
          return `
            <tr class="${isCurrent ? 'bg-[#1f2937]/60' : 'hover:bg-[#1c2128]'} transition">
              <td class="p-3">
                <div class="font-bold text-[#f0f6fc]">${escapeHtml(c.metadata.company)} — ${escapeHtml(c.metadata.period)}</div>
                <div class="text-[11px] text-[#8b949e] mono">${escapeHtml(c.metadata.filename)} (${c.metadata.wordCount.toLocaleString()} words)</div>
              </td>
              <td class="p-3 font-bold text-[#f0f6fc] mono">${c.qaAudit.candorScore} / 10</td>
              <td class="p-3"><span class="badge ${getCredibilityBadgeClass(c.credibilityRating)}">${escapeHtml(c.credibilityRating)}</span></td>
              <td class="p-3 mono">${c.qaAudit.deflectionRatePct}% (${c.qaAudit.deflectionEvents.length})</td>
              <td class="p-3 mono">${c.qaAudit.hedgeDensityPct}%</td>
              <td class="p-3 mono">${c.guidanceRecords.length} <span class="text-[#8b949e]">(${firmCnt} Firm / ${softCnt} Soft)</span></td>
              <td class="p-3 mono">${c.redFlags.length}</td>
              <td class="p-3">
                <button type="button" data-idx="${idx}" class="btnSelectCallTab px-2.5 py-1 rounded text-xs font-semibold ${isCurrent ? 'bg-[#58a6ff] text-[#0d1117]' : 'bg-[#21262d] text-[#c9d1d9] hover:bg-[#30363d]'}">
                  ${isCurrent ? 'Viewing' : 'Inspect'}
                </button>
              </td>
            </tr>
          `;
        }).join('');
      } else {
        multiSec.classList.add('hidden');
      }

      // Tabs
      const tabsContainer = document.getElementById('callTabsContainer');
      tabsContainer.innerHTML = analyzedCalls.map((c, idx) => {
        const active = idx === activeCallIndex;
        return `
          <button type="button" data-idx="${idx}" class="btnSelectCallTab px-3.5 py-2 rounded-lg text-xs font-semibold border transition flex items-center gap-2 ${
            active
              ? 'bg-[#58a6ff] text-[#0d1117] border-[#58a6ff]'
              : 'bg-[#161b22] text-[#c9d1d9] border-[#30363d] hover:border-[#58a6ff]'
          }">
            <span>#${idx + 1} ${escapeHtml(c.metadata.company)} (${escapeHtml(c.metadata.period)})</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] mono ${active ? 'bg-[#0d1117]/20 text-[#0d1117]' : 'bg-[#21262d] text-[#8b949e]'}">${c.qaAudit.candorScore}/10</span>
          </button>
        `;
      }).join('');

      document.querySelectorAll('.btnSelectCallTab').forEach(btn => {
        btn.addEventListener('click', () => {
          activeCallIndex = Number(btn.getAttribute('data-idx'));
          renderAll();
        });
      });

      renderActiveCallDetail();
    }

