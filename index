        <div id="redFlagsContainer" class="overflow-x-auto"></div>
      </section>

      <!-- Section 2: Forward Guidance & Numerical Commitments -->
      <section class="bg-[#161b22] border border-[#30363d] rounded-xl p-5 space-y-3">
