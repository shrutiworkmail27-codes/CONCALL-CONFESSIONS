        ? current.capexDebt.debt.slice(0, 10).map(d => `<li class="border-b border-[#30363d]/60 pb-2"><span class="text-[#d29922] font-semibold mono">[${escapeHtml(d.figures.join(', '))}]</span> ${escapeHtml(d.sentence)}</li>`).join('')
